generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  assistante
  responsable
  dirigeant
  conducteur
  externe
}

/// Droit d’accès application (pas la fonction métier)
enum Acces {
  administrateur
  collaborateur
  /// Syndic, MOE, fournisseur, sous-traitant — messagerie invitée uniquement
  externe
}

enum AffaireStatut {
  commande
  programme
  encours
  solde
}

enum AffaireType {
  travaux
  contrat_entretien
}

enum FactureType {
  acompte
  solde
}

enum PieceType {
  devis
  os
  photo
  autorisation
  facture
  autre
}

model User {
  id                  String   @id
  initiales           String   @unique
  /// Affichage court (prénom ou nom complet historique)
  nom                 String
  prenom              String   @default("")
  nomFamille          String   @default("")
  telephone           String   @default("")
  email               String   @unique
  passwordHash        String
  role                Role
  /// Administrateur, Collaborateur ou Participant externe
  acces               Acces    @default(collaborateur)
  /// Société (surtout participants externes)
  societe             String   @default("")
  /// Fonction / titre chez l’externe
  fonction            String   @default("")
  terrain             Boolean  @default(false)
  actif               Boolean  @default(true)
  /// Photo de profil (/uploads/... ou emoji)
  avatarUrl           String?
  lastLoginAt         DateTime?
  mustChangePassword  Boolean  @default(false)
  /// Incrémenté pour invalider les sessions JWT
  tokenVersion        Int      @default(0)
  createdAt           DateTime @default(now())

  taches          Tache[]            @relation("TacheResponsable")
  messages        Message[]
  pushSubs        PushSubscription[]
  notifications   NotificationLog[]
  urgenceTraitements UrgenceTraitement[]
  piecesUploadees Piece[]            @relation("PieceAuteur")
  remarques       Remarque[]
  adminAudits     AdminAuditLog[]    @relation("AdminAuteur")
  notifPrefs      UserNotifPrefs?
  supportTickets  SupportTicket[]
  threadMemberships ThreadMember[]
  threadInvitesSent ThreadMember[]   @relation("ThreadMemberInviter")
  invitesSent       ExternalInvite[] @relation("InviteAuteur")
  filesUploaded     SecureFile[]
  externalAudits    ExternalAuditLog[] @relation("ExtAuditAuteur")
}

/// Préférences de notification (1 par utilisateur)
model UserNotifPrefs {
  userId         String  @id
  pushEnabled    Boolean @default(true)
  emailEnabled   Boolean @default(false)
  alertMessages  Boolean @default(true)
  alertActions   Boolean @default(true)
  alertContrats  Boolean @default(true)
  alertRelances  Boolean @default(true)
  /// 1 = Info, 2 = À faire, 3 = Urgent (seuil minimum reçu)
  urgenceMin     Int     @default(1)
  silenceDebut   String  @default("22:00")
  silenceFin     String  @default("07:00")
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SupportStatut {
  envoyee
  en_cours
  resolue
}

enum SupportUrgence {
  basse
  normale
  haute
}

enum FactureAboStatut {
  payee
  en_attente
}

enum PeriodiciteAbo {
  mensuelle
  annuelle
}

enum ModeReglement {
  prelevement
  virement
  cheque
}

/// Identité & facturation de l’entreprise abonnée (singleton démo)
model Entreprise {
  id                   String         @id @default("setrim")
  raisonSociale        String
  adresse              String         @default("")
  siret                String         @default("")
  tvaIntra             String         @default("")
  logoUrl              String?
  facturationAdresse   String         @default("")
  facturationEmail     String         @default("")
  referenceCommande    String         @default("")
  modeReglement        ModeReglement  @default(prelevement)
  periodicite          PeriodiciteAbo @default(mensuelle)
  supportEmail         String         @default("contact@bework.fr")
  supportTelephone     String         @default("06 95 66 18 18")
  supportHoraires      String         @default("Lun–Ven 9h–18h")
  updatedAt            DateTime       @updatedAt

  abonnement Abonnement?
  factures   FacturePlateforme[]
}

model Abonnement {
  id                 String   @id @default(cuid())
  entrepriseId       String   @unique
  formule            String
  usersInclus        Int      @default(5)
  fonctionnalites    String   @default("")
  dateDebut          DateTime
  prochaineEcheance  DateTime
  renouvellementAuto Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
}

/// Factures de la plateforme (pas les factures chantier)
model FacturePlateforme {
  id            String           @id @default(cuid())
  entrepriseId  String
  numero        String
  dateEmission  DateTime
  periodeDebut  DateTime
  periodeFin    DateTime
  montantHt     Decimal          @db.Decimal(12, 2)
  montantTtc    Decimal          @db.Decimal(12, 2)
  statut        FactureAboStatut @default(en_attente)
  pdfUrl        String?
  createdAt     DateTime         @default(now())

  entreprise Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  @@index([entrepriseId, dateEmission])
}

model SupportTicket {
  id          String         @id @default(cuid())
  numero      String         @unique
  auteurId    String
  objet       String
  description String
  urgence     SupportUrgence @default(normale)
  statut      SupportStatut  @default(envoyee)
  captureUrl  String?
  /// probleme | changer_formule | ajouter_users | resilier
  kind        String         @default("probleme")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  auteur User @relation(fields: [auteurId], references: [id], onDelete: Cascade)

  @@index([auteurId, createdAt])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  auteurId  String
  action    String
  cibleId   String?
  detail    String   @default("")
  createdAt DateTime @default(now())

  auteur User @relation("AdminAuteur", fields: [auteurId], references: [id], onDelete: Cascade)
}

model Affaire {
  id                 String        @id @default(cuid())
  numeroDevis        String        @unique
  client             String
  /// Fiche client (syndic / maître d'ouvrage) — optionnelle
  clientId           String?
  adresse            String
  montantHt          Decimal       @db.Decimal(12, 2)
  montantTtc         Decimal?      @db.Decimal(12, 2)
  joursCharge        Int           @default(0)
  statut             AffaireStatut @default(commande)
  type               AffaireType   @default(travaux)
  dateDevis          DateTime?
  note               String        @default("")
  acompteHt          Decimal       @default(0) @db.Decimal(12, 2)
  dateDebut          DateTime?
  dateFin            DateTime?
  equipeId           String?
  contratEntretienId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  ficheClient      Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  equipe           Equipe?            @relation(fields: [equipeId], references: [id])
  contratEntretien ContratEntretien?  @relation(fields: [contratEntretienId], references: [id], onDelete: SetNull)
  taches           Tache[]
  messages         Message[]
  pieces           Piece[]
  factures         Facture[]
  slots            PlanningSlot[]
}

/// Fiche client (syndic, agence, particulier) — rattachée aux chantiers / affaires
model Client {
  id         String   @id @default(cuid())
  nom        String
  contact    String   @default("")
  telephone  String   @default("")
  email      String   @default("")
  adresse    String   @default("")
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  affaires Affaire[]

  @@index([nom])
}

model Tache {
  id             String    @id @default(cuid())
  titre          String
  affaireId      String?
  responsableId  String
  dateEcheance   DateTime
  niveau         Int       @default(2)
  fait           Boolean   @default(false)
  faitAt         DateTime?
  libelleAffaire String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  affaire     Affaire? @relation(fields: [affaireId], references: [id], onDelete: SetNull)
  responsable User     @relation("TacheResponsable", fields: [responsableId], references: [id])
}

model Message {
  id         String   @id @default(cuid())
  affaireId  String?
  threadKey  String   @default("gen")
  auteurId   String
  texte      String?
  photoLabel String?
  /// Chemin public /uploads/... ou /api/files/{id} (sécurisé)
  fichier    String?
  /// Note interne : invisible aux participants externes
  interne    Boolean  @default(false)
  systeme    Boolean  @default(false)
  createdAt  DateTime @default(now())

  affaire Affaire? @relation(fields: [affaireId], references: [id], onDelete: Cascade)
  auteur  User     @relation(fields: [auteurId], references: [id])

  @@index([threadKey, createdAt])
}

/// Appartenance d’un participant externe à un fil
model ThreadMember {
  id               String    @id @default(cuid())
  threadKey        String
  userId           String
  invitedById      String?
  invitedAt        DateTime  @default(now())
  /// null = tout l’historique ; sinon messages avec createdAt >= historyFrom
  historyFrom      DateTime?
  accessExpiresAt  DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("ThreadMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([threadKey, userId])
  @@index([userId])
  @@index([threadKey])
}

/// Invitation en attente (lien à usage unique, 7 jours)
model ExternalInvite {
  id               String    @id @default(cuid())
  token            String    @unique
  threadKey        String
  email            String
  nom              String
  societe          String    @default("")
  fonction         String    @default("")
  message          String    @default("")
  /// share_all | from_now
  historyMode      String    @default("from_now")
  /// days_30 | months_6 | chantier | unlimited
  accessDuration   String    @default("months_6")
  accessExpiresAt  DateTime?
  invitedById      String
  /// Expiration du lien d’invitation
  expiresAt        DateTime
  acceptedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())

  invitedBy User @relation("InviteAuteur", fields: [invitedById], references: [id])

  @@index([threadKey])
  @@index([email])
}

/// Fichier servi via /api/files/[id] (pas d’URL publique devinable)
model SecureFile {
  id           String   @id @default(cuid())
  threadKey    String
  storageName  String
  originalName String
  mime         String   @default("application/octet-stream")
  size         Int      @default(0)
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([threadKey])
}

model ExternalAuditLog {
  id           String   @id @default(cuid())
  action       String
  actorId      String?
  targetUserId String?
  targetEmail  String?
  threadKey    String?
  detail       String   @default("")
  createdAt    DateTime @default(now())

  actor User? @relation("ExtAuditAuteur", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([threadKey])
}

model Piece {
  id        String    @id @default(cuid())
  affaireId String
  type      PieceType @default(autre)
  titre     String
  fichier   String?
  auteurId  String?
  createdAt DateTime  @default(now())

  affaire Affaire @relation(fields: [affaireId], references: [id], onDelete: Cascade)
  auteur  User?   @relation("PieceAuteur", fields: [auteurId], references: [id])
}

model Facture {
  id               String      @id @default(cuid())
  affaireId        String
  type             FactureType
  montant          Decimal     @db.Decimal(12, 2)
  dateEmission     DateTime?
  dateEncaissement DateTime?
  numero           String?
  createdAt        DateTime    @default(now())

  affaire Affaire @relation(fields: [affaireId], references: [id], onDelete: Cascade)
}

model ContratEntretien {
  id              String    @id @default(cuid())
  immeuble        String
  syndic          String
  montantHt       Decimal   @db.Decimal(12, 2)
  nbCompagnons    Int       @default(1)
  moisContractuel Int
  exercice        String    @default("2026-2027")
  note            String    @default("")
  etat            String    @default("contract")
  datePosee       DateTime?
  createdAt       DateTime  @default(now())

  affaires Affaire[]
}

model Equipe {
  id         String @id @default(cuid())
  nom        String
  chef       String
  ordre      Int    @default(0)
  /// equipe | prestataire
  categorie  String @default("equipe")
  affaires   Affaire[]
  slots      PlanningSlot[]
}

model PlanningSlot {
  id        String   @id @default(cuid())
  equipeId  String
  date      DateTime @db.Date
  affaireId String?
  type      String   @default("chantier")
  label     String?
  tacheId   String?
  createdAt DateTime @default(now())

  equipe  Equipe   @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  affaire Affaire? @relation(fields: [affaireId], references: [id], onDelete: SetNull)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id       String   @id @default(cuid())
  userId   String
  tacheId  String?
  /// Clé stable d’événement (tache:…, planning:…, mention:…) — dédup push / popup
  eventKey String   @default("")
  kind     String
  sentAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tacheId, kind, sentAt])
  @@index([userId, eventKey, kind, sentAt])
}

/// Action « fait » / « reporter » depuis la pop-up Urgences (bloque le push le même jour)
model UrgenceTraitement {
  id        String   @id @default(cuid())
  userId    String
  eventKey  String
  /// done | snooze
  action    String
  until     DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, until])
}

model Remarque {
  id        String   @id @default(cuid())
  userId    String
  ecran     String
  texte     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ThreadMeta {
  id        String @id
  titre     String
  sousTitre String @default("")
  avatar    String @default("")
  cls       String @default("")
  pin       String @default("")
  ordre     Int    @default(0)
}
